# Copy this file to .env.local for local development, and set the same
# variables in your Vercel project settings (Project → Settings →
# Environment Variables) for production/preview deployments.
#
# See README.md for the full step-by-step guide to creating the Google
# Cloud service account and sharing the spreadsheet with it.

# --- Google Sheets API (service account, read-only) -------------------------

# The spreadsheet ID from the Google Sheets URL:
# https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEETS_ID=

# The service account's email address, e.g.
# zea-farma-dashboard@your-project-id.iam.gserviceaccount.com
# This email must be added as a Viewer on the "Smart Finance ZMF" spreadsheet.
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# The service account's private key, from the downloaded JSON key file's
# "private_key" field. Paste it exactly as-is, including the
# "-----BEGIN PRIVATE KEY-----" / "-----END PRIVATE KEY-----" lines.
# - In Vercel's dashboard, paste it as a single value; the multi-line PEM
#   with literal newlines is accepted as-is.
# - If you set it via a shell/.env file and it collapses to one line with
#   literal "\n" sequences, that's fine too — the app un-escapes them.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"

# Optional: override these only if you rename the tabs in the spreadsheet.
# Defaults match the current "Smart Finance ZMF" template.
SHEET_TAB_INCOME=Income
SHEET_TAB_EXPENSES=Expenses
SHEET_TAB_SETUP=Setup

# --- Access control -----------------------------------------------------

# Password required to view the dashboard (simple password gate).
# Choose a strong, random value — treat it like any other credential.
DASHBOARD_PASSWORD=

# Secret used to sign the login session cookie. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET=
